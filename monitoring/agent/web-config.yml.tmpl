# Exporter web config (TLS + basic auth) for node_exporter and
# postgres_exporter. Template: the deploy workflow replaces the marker line
# below with one bcrypt entry per accepted user and installs the result as
# ~/monitoring-agent/secrets/exporter/web-config.yml (uid 65534, 0400). The
# exporters re-read this file on every request.
tls_server_config:
  cert_file: /etc/exporter/tls.crt
  key_file: /etc/exporter/tls.key
  min_version: TLS12
basic_auth_users:
  # @@BASIC_AUTH_USERS@@
