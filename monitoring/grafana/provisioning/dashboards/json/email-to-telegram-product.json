{
  "uid": "e2t-product",
  "title": "Email to Telegram – Product",
  "description": "Users, activation and usage trends. Times are UTC, so daily bars are UTC days.",
  "tags": ["email-to-telegram", "product"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "label": "Env",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "Prometheus-env-Variable-Query"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod",
          "selected": true
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Activation funnel",
      "description": "signed up → created an alias (undeleted, incl. paused) → ever received mail (accepted into delivery in any month) → received mail this month (resets on the 1st). Bad: a big drop between alias and ever received mail: users set up an address but never use it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"total\"})",
          "legendFormat": "signed up",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"with_alias\"})",
          "legendFormat": "created an alias",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"ever_delivered\"})",
          "legendFormat": "ever received mail",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"accepted_mail_this_month\"})",
          "legendFormat": "received mail this month",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Users and aliases",
      "description": "Growth over the range: users, users with an alias, users who ever received mail, and active aliases. Bad: users growing while ever received mail stays flat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "users"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "users with an alias"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "users who ever received mail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "active aliases"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"total\"})",
          "legendFormat": "users"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"with_alias\"})",
          "legendFormat": "users with an alias"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_users{env=~\"$env\",state=\"ever_delivered\"})",
          "legendFormat": "users who ever received mail"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_aliases{env=~\"$env\",status=\"active\"})",
          "legendFormat": "active aliases"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Delivered per day",
      "description": "Mails Telegram accepted per UTC day, first attempts plus retries; each bar is the day ending at its right edge, the current day is not drawn yet. Total is the sum over the range. Bad: a sudden drop with no matching drop in users.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": -1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "delivered"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum", "mean"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(email_to_telegram_delivery_attempts_total{result=\"succeeded\",env=~\"$env\"}[$__interval])) or vector(0)) + (sum(increase(email_to_telegram_retry_attempts_total{result=\"succeeded\",env=~\"$env\"}[$__interval])) or vector(0))",
          "legendFormat": "delivered"
        }
      ],
      "interval": "1d",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Quota rejections per day by reason",
      "description": "Mail refused because a user hit a plan limit, per UTC day. monthly_email_limit: over the monthly cap (the sender gets a bounce, the user a notice). Bad: the same users hitting it every month.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": -1
          },
          "color": {
            "mode": "shades",
            "fixedColor": "orange"
          },
          "noValue": "No quota rejections in this range",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(email_to_telegram_quota_rejections_total{env=~\"$env\"}[$__interval])) > 0",
          "legendFormat": "{{reason}}"
        }
      ],
      "interval": "1d",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Users by plan",
      "description": "Users per plan code (every user is on exactly one plan). Bad: paid plans shrinking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (plan) (email_to_telegram_active_users_by_plan{env=~\"$env\"})",
          "legendFormat": "{{plan}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Aliases by status",
      "description": "Aliases by status: active receive mail, paused do not. Bad: paused or deleted growing faster than active.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (email_to_telegram_aliases{env=~\"$env\"})",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 16
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Chats",
      "description": "Telegram chats the bot knows: active (still reachable) and total. Bad: active falling behind total (users blocking the bot or removing it from groups).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_chats{env=~\"$env\",state=\"active\"})",
          "legendFormat": "active",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_chats{env=~\"$env\",state=\"total\"})",
          "legendFormat": "total",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 16
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Attachments storage",
      "description": "Size and count of stored attachments (download links). Bad: growth without matching mail volume (attachment TTL cleanup not running).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "files"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_attachments_stored_bytes{env=~\"$env\"})",
          "legendFormat": "stored",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(email_to_telegram_attachments_stored{env=~\"$env\"})",
          "legendFormat": "files",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 16
      }
    }
  ]
}
